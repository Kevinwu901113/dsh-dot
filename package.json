{
  "name": "dsh-dot",
  "version": "0.7.1",
  "description": "dot — a Dots-style always-on agent for DeepSeek Harness, in one plugin: its own computer (a bundled microVM with shell, browser, live view and approval gates), the always-on glue (schedules → IM, silence protocol, approval cards), and an interlude — a life between conversations after HDS-Interlude (Canon by share code, script, continuity, browsing in her own browser). Works with dsh-im and the official schedule bundle.",
  "type": "module",
  "license": "AGPL-3.0-only",
  "keywords": [
    "agent",
    "always-on",
    "computer-use",
    "deepseek-harness",
    "dots",
    "dsh",
    "dsh-plugin",
    "hds-interlude",
    "interlude",
    "microsandbox",
    "microvm",
    "persona",
    "sandbox"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kevinwu901113/dsh-dot.git"
  },
  "homepage": "https://github.com/Kevinwu901113/dsh-dot#readme",
  "exports": {
    ".": "./src/computer/ui-host.js",
    "./client": "./lib/client.js",
    "./computer": "./src/computer/vm.js",
    "./vm": "./src/computer/vm.js",
    "./subprocess": "./src/computer/subprocess.js",
    "./gate": "./src/computer/gate.js",
    "./core": "./src/dot/core.js",
    "./dot": "./src/dot/core.js",
    "./package.json": "./package.json",
    "./interlude": "./src/interlude/core.js",
    "./memory": "./src/memory/memory.js",
    "./phone": "./src/phone/phone.js",
    "./qq": "./src/qq/qq.js"
  },
  "files": [
    "src",
    "lib",
    "scripts",
    "examples",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-subprocess": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-subprocess-local": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-mcp-client": ">=0.2.0-rc.2"
  },
  "dependencies": {
    "microsandbox": "0.7.8",
    "@mobilenext/mobile-mcp": "1.0.12",
    "ws": "^8.18.0"
  }
}
