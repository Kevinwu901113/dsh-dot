{
  "name": "dsh-dot-life",
  "version": "0.23.0",
  "description": "dot — a character who lives on her own phone, for DeepSeek Harness (dsh): an Android phone the plugin installs and runs, her own QQ, memory and a diary from real events, a life between conversations (幕间), an optional microVM computer with approval gates. One plugin, seven components; lives next to qq-bridge.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "companion",
    "character",
    "养鱼",
    "陪伴",
    "qq",
    "napcat",
    "android",
    "emulator",
    "phone",
    "memory",
    "diary",
    "interlude",
    "hds-interlude",
    "persona",
    "microvm",
    "microsandbox",
    "qq-bridge"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kevinwu901113/dsh-dot.git"
  },
  "homepage": "https://github.com/Kevinwu901113/dsh-dot#readme",
  "exports": {
    ".": "./src/page/host.js",
    "./client": "./lib/client.js",
    "./computer": "./src/computer/vm.js",
    "./vm": "./src/computer/vm.js",
    "./subprocess": "./src/computer/subprocess.js",
    "./gate": "./src/computer/gate.js",
    "./core": "./src/dot/core.js",
    "./dot": "./src/dot/core.js",
    "./package.json": "./package.json",
    "./interlude": "./src/interlude/core.js",
    "./memory": "./src/memory/memory.js",
    "./phone": "./src/phone/phone.js",
    "./qq": "./src/qq/qq.js",
    "./compat": "./src/compat/qq-bridge.js"
  },
  "files": [
    "src",
    "lib",
    "scripts/prompts.mjs",
    "examples",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "prompts": "node scripts/prompts.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-subprocess": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-subprocess-local": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-mcp-client": ">=0.2.0-rc.2"
  },
  "dependencies": {
    "microsandbox": "0.7.8",
    "@mobilenext/mobile-mcp": "1.0.12",
    "ws": "^8.18.0"
  }
}
